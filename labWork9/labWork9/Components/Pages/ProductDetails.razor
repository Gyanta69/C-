@page "/product-details/{Id:int}"
@inject ProductStore ProductStore
@inject NavigationManager Navigation

<PageTitle>Product Details</PageTitle>

@if (product == null)
{
    <div class="alert alert-warning">
        <h2>Product Not Found</h2>
        <p>The product you are looking for does not exist.</p>
        <a href="/products" class="btn btn-primary">Back to Products</a>
    </div>
}
else
{
    <div class="mb-3">
        <a href="/products" class="btn btn-secondary">← Back to Products</a>
    </div>

    <div class="card">
        <div class="card-header">
            <h2>Product Details</h2>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(product.ImageBase64))
            {
                <div class="mb-4 text-center">
                    <img src="@GetImageSrc()" alt="@product.Name" class="img-fluid rounded" style="max-width: 400px; max-height: 400px; object-fit: contain;" />
                </div>
            }
            <dl class="row">
                <dt class="col-sm-3">Product ID:</dt>
                <dd class="col-sm-9">@product.Id</dd>

                <dt class="col-sm-3">Name:</dt>
                <dd class="col-sm-9">@product.Name</dd>

                <dt class="col-sm-3">Description:</dt>
                <dd class="col-sm-9">@(product.Description ?? "No description provided")</dd>

                <dt class="col-sm-3">Category:</dt>
                <dd class="col-sm-9">@product.Category</dd>

                <dt class="col-sm-3">Price:</dt>
                <dd class="col-sm-9">$@product.Price.ToString("F2")</dd>

                <dt class="col-sm-3">Stock Quantity:</dt>
                <dd class="col-sm-9">@product.Stock</dd>
            </dl>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Product? product;

    protected override void OnInitialized()
    {
        product = ProductStore.GetProductById(Id);
    }

    private string GetImageSrc()
    {
        if (product == null || string.IsNullOrEmpty(product.ImageBase64))
            return string.Empty;
        
        return $"data:{product.ImageContentType ?? "image/png"};base64,{product.ImageBase64}";
    }
}

